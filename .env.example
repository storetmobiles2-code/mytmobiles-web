# ── Required ─────────────────────────────────────────────
# PostgreSQL 14+ connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mytmobiles?schema=public"
# Public URL of the site (used in emails, sitemaps, canonical URLs)
NEXT_PUBLIC_SITE_URL="https://www.example.com"
# Protects /api/cron/* (unpaid-order expiry etc). 32+ random characters.
CRON_SECRET=""

# First admin account, created by `npx prisma db seed` (min 10 chars)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── Online payments (Razorpay) — online payment is hidden at checkout until set ──
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Webhooks → https://<site>/api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=""

# ── Transactional email (SMTP) — order/password emails ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="myT Mobiles <orders@example.com>"

# ── Optional ──
# Google Analytics 4 measurement ID (e.g. G-XXXXXXX); first-party analytics work without it
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Keep stable across instances so Server Action references stay valid during deploys
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
DATABASE_POOL_SIZE="10"
