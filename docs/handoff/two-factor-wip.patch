+import AxeBuilder from "@axe-core/playwright";
+import type { Page } from "@playwright/test";
+import { test, expect, freshTotpCode, signIn, withDb } from "./fixtures";
+import { totpCode, totpStep } from "../../src/lib/auth/totp";
+
+/**
+ * Admin two-factor sign-in: a new admin is sent to Security, enrols with the
+ * setup key, then signs in with an app code and with a recovery code.
+ * Creates a throwaway admin account and deletes it at the end.
+ */
+const email = `e2e-2fa+${Date.now()}@example.com`;
+const password = "secret123A";
+let secret = "";
+let recoveryCodes: string[] = [];
+
+async function expectNoAxeViolations(page: Page) {
+  const { violations } = await new AxeBuilder({ page }).withTags(["wcag2a", "wcag2aa", "wcag21a", "wcag21aa"]).analyze();
+  expect(violations.map((v) => `${v.id} (${v.impact}): ${v.nodes.length}× e.g. ${v.nodes[0]?.target.join(" ")}`)).toEqual([]);
+}
+
+async function signOut(page: Page) {
+  await page.getByRole("button", { name: "Sign out" }).click();
+  await page.waitForURL((u) => u.pathname === "/");
+}
+
+async function passwordStep(page: Page) {
+  await page.goto("/login?next=/admin");
+  await page.getByLabel("Email", { exact: true }).fill(email);
+  await page.getByLabel("Password", { exact: true }).fill(password);
+  await page.getByRole("button", { name: "Sign in" }).click();
+  await page.waitForURL(/\/login\/verify/);
+}
+
+test.describe.serial("admin two-factor sign-in", () => {
+  test.afterAll(async () => {
+    await withDb((c) => c.query(`DELETE FROM "User" WHERE email = $1`, [email]));
+  });
+
+  test("a new admin must enrol before using the admin panel", async ({ page }) => {
+    await page.goto("/register");
+    await page.getByLabel("Full name").fill("E2E Two Factor");
+    await page.getByLabel("Email", { exact: true }).fill(email);
+    await page.getByLabel("Password", { exact: true }).fill(password);
+    await page.getByLabel(/I agree/).check();
+    await page.getByRole("button", { name: "Create account" }).click();
+    await page.waitForURL(/\/account/);
+    await withDb((c) => c.query(`UPDATE "User" SET role = 'ADMIN' WHERE email = $1`, [email]));
+
+    // Every admin page redirects to Security, and only Security is in the menu.
+    await page.goto("/admin/orders");
+    await expect(page).toHaveURL(/\/admin\/security$/);
+    await expect(page.getByRole("heading", { name: "Security", level: 1 })).toBeVisible();
+    await expect(page.getByText("Admin accounts must use two-factor sign-in")).toBeVisible();
+    await expect(page.getByRole("navigation", { name: "Admin" }).getByRole("link", { name: "Orders" })).toHaveCount(0);
+
+    await page.getByRole("button", { name: "Set up two-factor sign-in" }).click();
+    const key = page.getByTestId("totp-setup-key");
+    await expect(key).toBeVisible();
+    await expect(page.getByRole("img", { name: /QR code/ })).toBeVisible();
+    await page.waitForLoadState("networkidle");
+    await expectNoAxeViolations(page);
+    secret = (await key.textContent())!.replace(/\s/g, "");
+    expect(secret).toMatch(/^[A-Z2-7]{32}$/);
+
+    // A wrong code is refused.
+    const right = totpCode(secret, totpStep());
+    await page.getByLabel("6-digit code from the app").fill(right === "123456" ? "654321" : "123456");
+    await page.getByRole("button", { name: "Turn on two-factor sign-in" }).click();
+    await expect(page.getByText("That code didn't work")).toBeVisible();
+
+    await page.getByLabel("6-digit code from the app").fill(totpCode(secret, totpStep()));
+    await page.getByRole("button", { name: "Turn on two-factor sign-in" }).click();
+    await expect(page.getByText("Save your recovery codes now")).toBeVisible();
+    recoveryCodes = await page.getByRole("list", { name: "Recovery codes" }).getByRole("listitem").allTextContents();
+    expect(recoveryCodes).toHaveLength(10);
+    await page.getByRole("button", { name: "I've saved my codes" }).click();
+    await expect(page.getByText("10 of 10 unused")).toBeVisible();
+    await expect(page.getByRole("navigation", { name: "Admin" }).getByRole("link", { name: "Orders" })).toBeVisible();
+
+    await page.goto("/admin");
+    await expect(page.getByRole("heading", { name: "Dashboard" })).toBeVisible();
+    await signOut(page);
+  });
+
+  test("signs in with an authenticator code; a wrong code shows an error", async ({ page }) => {
+    await passwordStep(page);
+    await page.waitForLoadState("networkidle");
+    await expectNoAxeViolations(page);
+
+    // No session yet: the admin panel still asks to sign in.
+    const admin = await page.request.get("/admin", { maxRedirects: 0 });
+    expect(admin.headers()["location"] ?? "").toContain("/login");
+
+    await page.getByLabel("Code", { exact: true }).fill("000000");
+    await page.getByRole("button", { name: "Verify" }).click();
+    await expect(page.getByText("That code didn't work")).toBeVisible();
+
+    await page.getByLabel("Code", { exact: true }).fill(await freshTotpCode(email, secret));
+    await page.getByRole("button", { name: "Verify" }).click();
+    await expect(page.getByRole("heading", { name: "Dashboard" })).toBeVisible();
+    await signOut(page);
+  });
+
+  test("signs in with a recovery code, which then stops working", async ({ page }) => {
+    await passwordStep(page);
+    await page.getByLabel("Code", { exact: true }).fill(recoveryCodes[0]);
+    await page.getByRole("button", { name: "Verify" }).click();
+    await expect(page.getByRole("heading", { name: "Dashboard" })).toBeVisible();
+    await page.goto("/admin/security");
+    await expect(page.getByText("9 of 10 unused")).toBeVisible();
+    await signOut(page);
+
+    await passwordStep(page);
+    await page.getByLabel("Code", { exact: true }).fill(recoveryCodes[0]);
+    await page.getByRole("button", { name: "Verify" }).click();
+    await expect(page.getByText("That code didn't work")).toBeVisible();
+    await page.getByLabel("Code", { exact: true }).fill(recoveryCodes[1]);
+    await page.getByRole("button", { name: "Verify" }).click();
+    await expect(page.getByRole("heading", { name: "Dashboard" })).toBeVisible();
+    await signOut(page);
+  });
+
+  test("locks the code step after 5 wrong codes", async ({ page }) => {
+    await passwordStep(page);
+    // Wait for each answer: the error text from the previous try is still on screen.
+    const tryCode = async (code: string) => {
+      await page.getByLabel("Code", { exact: true }).fill(code);
+      await Promise.all([page.waitForResponse((r) => r.request().method() === "POST"), page.getByRole("button", { name: "Verify" }).click()]);
+    };
+    for (let i = 0; i < 4; i++) {
+      await tryCode("zzzz-zzzz-zzzz");
+      await expect(page.getByText("That code didn't work")).toBeVisible();
+    }
+    await tryCode("zzzz-zzzz-zzzz");
+    await expect(page.getByText("Too many wrong codes")).toBeVisible();
+
+    // Even the right code is refused while locked.
+    await signIn(page, { email, password, secret });
+    await expect(page.getByText("Too many wrong codes")).toBeVisible();
+  });
+});
diff --git a/tests/unit/totp.test.ts b/tests/unit/totp.test.ts
new file mode 100644
index 0000000..735ecee
--- /dev/null
+++ b/tests/unit/totp.test.ts
@@ -0,0 +1,103 @@
+import { describe, expect, it } from "vitest";
+import { base32Decode, base32Encode, formatManualKey, generateTotpSecret, otpauthUri, totpCode, totpStep, verifyTotp, type TotpAlgorithm } from "@/lib/auth/totp";
+
+const b32 = (ascii: string) => base32Encode(Buffer.from(ascii, "ascii"));
+
+// RFC 6238 Appendix B: 8-digit codes, 30-second steps, ASCII seeds per algorithm.
+const SEEDS: Record<TotpAlgorithm, string> = {
+  sha1: "12345678901234567890",
+  sha256: "12345678901234567890123456789012",
+  sha512: "1234567890123456789012345678901234567890123456789012345678901234",
+};
+const VECTORS: [number, Record<TotpAlgorithm, string>][] = [
+  [59, { sha1: "94287082", sha256: "46119246", sha512: "90693936" }],
+  [1111111109, { sha1: "07081804", sha256: "68084774", sha512: "25091201" }],
+  [1111111111, { sha1: "14050471", sha256: "67062674", sha512: "99943326" }],
+  [1234567890, { sha1: "89005924", sha256: "91819424", sha512: "93441116" }],
+  [2000000000, { sha1: "69279037", sha256: "90698825", sha512: "38618901" }],
+  [20000000000, { sha1: "65353130", sha256: "77737706", sha512: "47863826" }],
+];
+
+describe("TOTP (RFC 6238)", () => {
+  for (const [t, codes] of VECTORS) {
+    for (const algo of ["sha1", "sha256", "sha512"] as const) {
+      it(`${algo} at T=${t}`, () => {
+        expect(totpCode(b32(SEEDS[algo]), totpStep(t * 1000), 8, algo)).toBe(codes[algo]);
+      });
+    }
+  }
+
+  it("6-digit codes are the last 6 digits of the RFC values", () => {
+    expect(totpCode(b32(SEEDS.sha1), totpStep(59_000))).toBe("287082");
+    expect(totpCode(b32(SEEDS.sha1), totpStep(1111111109_000))).toBe("081804");
+  });
+});
+
+describe("base32", () => {
+  it("round-trips and matches RFC 4648", () => {
+    expect(base32Encode(Buffer.from("foobar"))).toBe("MZXW6YTBOI");
+    expect(base32Decode("MZXW6YTBOI").toString()).toBe("foobar");
+    expect(base32Decode("mzxw 6ytb-oi==").toString()).toBe("foobar");
+    const secret = generateTotpSecret();
+    expect(secret).toMatch(/^[A-Z2-7]{32}$/);
+    expect(base32Decode(secret)).toHaveLength(20);
+  });
+
+  it("rejects invalid characters", () => {
+    expect(() => base32Decode("ABC1")).toThrow();
+  });
+});
+
+describe("verifyTotp", () => {
+  const secret = b32(SEEDS.sha1);
+  const now = 1_700_000_000_000;
+  const step = totpStep(now);
+  const at = (s: number) => totpCode(secret, s);
+
+  it("accepts the current step and one step either side", () => {
+    expect(verifyTotp(secret, at(step), { nowMs: now })).toBe(step);
+    expect(verifyTotp(secret, at(step - 1), { nowMs: now })).toBe(step - 1);
+    expect(verifyTotp(secret, at(step + 1), { nowMs: now })).toBe(step + 1);
+  });
+
+  it("rejects codes outside the window", () => {
+    expect(verifyTotp(secret, at(step - 2), { nowMs: now })).toBeNull();
+    expect(verifyTotp(secret, at(step + 2), { nowMs: now })).toBeNull();
+  });
+
+  it("refuses a code from a step already used (replay)", () => {
+    expect(verifyTotp(secret, at(step), { nowMs: now, lastStep: step })).toBeNull();
+    expect(verifyTotp(secret, at(step - 1), { nowMs: now, lastStep: step - 1 })).toBeNull();
+    // A newer step is still fine.
+    expect(verifyTotp(secret, at(step + 1), { nowMs: now, lastStep: step })).toBe(step + 1);
+  });
+
+  it("ignores a space in the middle and rejects malformed input", () => {
+    const c = at(step);
+    expect(verifyTotp(secret, `${c.slice(0, 3)} ${c.slice(3)}`, { nowMs: now })).toBe(step);
+    expect(verifyTotp(secret, "", { nowMs: now })).toBeNull();
+    expect(verifyTotp(secret, "12345", { nowMs: now })).toBeNull();
+    expect(verifyTotp(secret, "abcdef", { nowMs: now })).toBeNull();
+  });
+
+  it("rejects a code made with another secret", () => {
+    expect(verifyTotp(generateTotpSecret(), at(step), { nowMs: now })).toBeNull();
+  });
+});
+
+describe("otpauth URI", () => {
+  it("has the parameters authenticator apps expect", () => {
+    const uri = otpauthUri({ secret: "JBSWY3DPEHPK3PXP", account: "owner@example.com", issuer: "myT Mobiles" });
+    expect(uri.startsWith("otpauth://totp/myT%20Mobiles:owner%40example.com?")).toBe(true);
+    const params = new URL(uri).searchParams;
+    expect(params.get("secret")).toBe("JBSWY3DPEHPK3PXP");
+    expect(params.get("issuer")).toBe("myT Mobiles");
+    expect(params.get("algorithm")).toBe("SHA1");
+    expect(params.get("digits")).toBe("6");
+    expect(params.get("period")).toBe("30");
+  });
+
+  it("formats the manual key in groups of four", () => {
+    expect(formatManualKey("JBSWY3DPEHPK3PXP")).toBe("JBSW Y3DP EHPK 3PXP");
+  });
+});
diff --git a/tests/unit/two-factor.test.ts b/tests/unit/two-factor.test.ts
new file mode 100644
index 0000000..a6a706e
--- /dev/null
+++ b/tests/unit/two-factor.test.ts
@@ -0,0 +1,167 @@
+import { randomBytes } from "node:crypto";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { generateTotpSecret, totpCode, totpStep } from "@/lib/auth/totp";
+import {
+  decryptSecret,
+  encryptSecret,
+  generateRecoveryCodes,
+  hashRecoveryCode,
+  looksLikeRecoveryCode,
+  normaliseRecoveryCode,
+  parseEncryptionKey,
+} from "@/lib/auth/two-factor-crypto";
+
+const KEY_B64 = randomBytes(32).toString("base64");
+
+describe("secret encryption (AES-256-GCM)", () => {
+  const key = parseEncryptionKey(KEY_B64);
+
+  it("round-trips", () => {
+    const secret = generateTotpSecret();
+    const enc = encryptSecret(secret, key, "user_1");
+    expect(enc).not.toContain(secret);
+    expect(enc.startsWith("v1.")).toBe(true);
+    expect(decryptSecret(enc, key, "user_1")).toBe(secret);
+  });
+
+  it("uses a fresh IV each time", () => {
+    expect(encryptSecret("SAME", key, "u")).not.toBe(encryptSecret("SAME", key, "u"));
+  });
+
+  it("fails with the wrong key, the wrong user or tampered data", () => {
+    const enc = encryptSecret("JBSWY3DPEHPK3PXP", key, "user_1");
+    expect(() => decryptSecret(enc, parseEncryptionKey(randomBytes(32).toString("base64")), "user_1")).toThrow();
+    expect(() => decryptSecret(enc, key, "user_2")).toThrow();
+    const parts = enc.split(".");
+    const ct = Buffer.from(parts[3], "base64url");
+    ct[0] ^= 1;
+    expect(() => decryptSecret([...parts.slice(0, 3), ct.toString("base64url")].join("."), key, "user_1")).toThrow();
+    expect(() => decryptSecret("garbage", key, "user_1")).toThrow();
+  });
+
+  it("refuses a missing or short key with a clear message", () => {
+    expect(() => parseEncryptionKey(undefined)).toThrow(/TOTP_ENCRYPTION_KEY is not set.*openssl rand -base64 32/);
+    expect(() => parseEncryptionKey("")).toThrow(/not set/);
+    expect(() => parseEncryptionKey(randomBytes(16).toString("base64"))).toThrow(/must be 32 bytes/);
+  });
+});
+
+describe("recovery codes", () => {
+  it("generates 10 distinct, readable codes", () => {
+    const codes = generateRecoveryCodes();
+    expect(codes).toHaveLength(10);
+    expect(new Set(codes).size).toBe(10);
+    for (const c of codes) {
+      expect(c).toMatch(/^[2-9a-hjkmnp-z]{4}-[2-9a-hjkmnp-z]{4}-[2-9a-hjkmnp-z]{4}$/);
+      expect(looksLikeRecoveryCode(c)).toBe(true);
+    }
+  });
+
+  it("hashes the normalised code, so case, spaces and dashes don't matter", () => {
+    const [code] = generateRecoveryCodes(1);
+    const h = hashRecoveryCode(code);
+    expect(h).toMatch(/^[0-9a-f]{64}$/);
+    expect(h).not.toContain(normaliseRecoveryCode(code));
+    expect(hashRecoveryCode(code.toUpperCase().replace(/-/g, " "))).toBe(h);
+    expect(hashRecoveryCode(generateRecoveryCodes(1)[0])).not.toBe(h);
+  });
+
+  it("tells recovery codes from app codes", () => {
+    expect(looksLikeRecoveryCode("123456")).toBe(false);
+    expect(looksLikeRecoveryCode("abcd-efgh-jkmn")).toBe(true);
+    expect(looksLikeRecoveryCode("abcd-efgh-jkm0")).toBe(false);
+  });
+});
+
+// ───────── checkSecondFactor against an in-memory database ─────────
+
+const store = vi.hoisted(() => ({
+  user: null as null | { id: string; totpSecretEnc: string | null; totpEnabledAt: Date | null; totpLastStep: number | null },
+  codes: [] as { userId: string; codeHash: string; usedAt: Date | null }[],
+  failures: 0,
+}));
+
+vi.mock("@/lib/env", () => ({ env: () => ({ TOTP_ENCRYPTION_KEY: KEY_B64, NODE_ENV: "test" }) }));
+vi.mock("next/headers", () => ({ cookies: vi.fn(), headers: vi.fn() }));
+vi.mock("next/navigation", () => ({ redirect: vi.fn() }));
+vi.mock("@/lib/db", () => {
+  type Where = { id?: string; userId?: string; codeHash?: string; usedAt?: null; OR?: { totpLastStep: null | { lt: number } }[] };
+  const db = {
+    user: {
+      findUnique: async () => store.user,
+      updateMany: async ({ where, data }: { where: Where; data: { totpLastStep: number } }) => {
+        const u = store.user;
+        if (!u || u.id !== where.id) return { count: 0 };
+        const fresh = u.totpLastStep === null || u.totpLastStep < data.totpLastStep;
+        if (!fresh) return { count: 0 };
+        u.totpLastStep = data.totpLastStep;
+        return { count: 1 };
+      },
+    },
+    recoveryCode: {
+      updateMany: async ({ where }: { where: Where }) => {
+        const row = store.codes.find((c) => c.userId === where.userId && c.codeHash === where.codeHash && c.usedAt === null);
+        if (!row) return { count: 0 };
+        row.usedAt = new Date();
+        return { count: 1 };
+      },
+    },
+    rateLimit: { deleteMany: async () => ((store.failures = 0), { count: 1 }) },
+    // Lockout queries: SELECT → locked?, INSERT → count a failure.
+    $queryRaw: async (sql: TemplateStringsArray) => {
+      if (sql.join("").includes("SELECT")) return [{ locked: store.failures >= 5 }];
+      store.failures += 1;
+      return [{ count: store.failures }];
+    },
+  };
+  return { db };
+});
+
+const { checkSecondFactor } = await import("@/lib/auth/two-factor");
+
+describe("checkSecondFactor", () => {
+  const secret = generateTotpSecret();
+  const codes = generateRecoveryCodes();
+
+  beforeEach(() => {
+    store.user = { id: "u1", totpSecretEnc: encryptSecret(secret, parseEncryptionKey(KEY_B64), "u1"), totpEnabledAt: new Date(), totpLastStep: null };
+    store.codes = codes.map((c) => ({ userId: "u1", codeHash: hashRecoveryCode(c), usedAt: null }));
+    store.failures = 0;
+  });
+
+  it("accepts the current app code once, then refuses it (replay)", async () => {
+    const step = totpStep();
+    const code = totpCode(secret, step);
+    expect(await checkSecondFactor("u1", code)).toBe("ok");
+    expect(store.user!.totpLastStep).toBe(step);
+    expect(await checkSecondFactor("u1", code)).toBe("invalid");
+  });
+
+  it("accepts a recovery code only once", async () => {
+    expect(await checkSecondFactor("u1", codes[3].toUpperCase())).toBe("ok");
+    expect(await checkSecondFactor("u1", codes[3])).toBe("invalid");
+    expect(await checkSecondFactor("u1", codes[4])).toBe("ok");
+  });
+
+  it("can refuse recovery codes where only an app code is allowed", async () => {
+    expect(await checkSecondFactor("u1", codes[0], { allowRecovery: false })).toBe("invalid");
+  });
+
+  it("locks after 5 wrong codes, even for a right one", async () => {
+    for (let i = 0; i < 4; i++) expect(await checkSecondFactor("u1", "zzzz-zzzz-zzzz")).toBe("invalid");
+    expect(await checkSecondFactor("u1", "zzzz-zzzz-zzzz")).toBe("locked");
+    expect(await checkSecondFactor("u1", totpCode(secret, totpStep()))).toBe("locked");
+  });
+
+  it("clears the failure count after a right code", async () => {
+    expect(await checkSecondFactor("u1", "zzzz-zzzz-zzzz")).toBe("invalid");
+    expect(store.failures).toBe(1);
+    expect(await checkSecondFactor("u1", codes[0])).toBe("ok");
+    expect(store.failures).toBe(0);
+  });
+
+  it("refuses everything when 2FA is not on", async () => {
+    store.user = { ...store.user!, totpEnabledAt: null };
+    expect(await checkSecondFactor("u1", totpCode(secret, totpStep()))).toBe("invalid");
+  });
+});
